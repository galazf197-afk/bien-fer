        "# TALLER 02: CASO ANDESLOG\n",
        "# ==========================================\n",
        "\n",
        "# 1. Definir constante del Umbral\n",
        "UMBRAL = 20_000\n",
        "\n",
        "# 2. Datos de entrada (Lista de diccionarios)\n",
        "pedidos = [\n",
        "    {\"id\": 101, \"sucursal\": \"Norte\", \"monto\": 15000, \"atrasado\": False},\n",
        "    {\"id\": 102, \"sucursal\": \"Sur\", \"monto\": 25000, \"atrasado\": True},\n",
        "    {\"id\": 103, \"sucursal\": \"Norte\", \"monto\": None, \"atrasado\": False},  # Registro con dato ausente\n",
        "    {\"id\": 104, \"sucursal\": \"Centro\", \"monto\": 30000, \"atrasado\": True}\n",
        "]\n",
        "\n",
        "# 3. Inicializar contadores y acumuladores\n",
        "cantidad_validos = 0\n",
        "total_montos = 0\n",
        "conteo_sobre_umbral = 0\n",
        "\n",
        "# Variables adicionales (\"Ahora inténtalo tú\")\n",
        "pedidos_atrasados = 0\n",
        "pedidos_norte = 0\n",
        "\n",
        "# 4. Bucle para procesar cada pedido\n",
        "for pedido in pedidos:\n",
        "    # Conteo por sucursal Norte\n",
        "    if pedido[\"sucursal\"] == \"Norte\":\n",
        "        pedidos_norte += 1\n",
        "\n",
        "    # Conteo de pedidos atrasados\n",
        "    if pedido[\"atrasado\"]:\n",
        "        pedidos_atrasados += 1\n",
        "\n",
        "    if pedido[\"monto\"] is None:\n",
        "        continue\n",
        "\n",
        "    cantidad_validos += 1\n",
        "    total_montos += pedido[\"monto\"]\n",
        "\n",
        "\n",
        "    if pedido[\"monto\"] > UMBRAL:\n",
        "        conteo_sobre_umbral += 1\n",
        "\n",
        "\n",
        "promedio = total_montos / cantidad_validos if cantidad_validos > 0 else 0\n",
        "\n",
        "print (\"resultados del analisis Andeslog\")\n",
        "print(f\"Pedidos válidos procesados: {cantidad_validos}\")\n",
        "print(f\"Suma total de montos: ${total_montos:,.0f}\")\n",
        "print(f\"Promedio de monto por pedido válido: ${promedio:,.2f}\")\n",
        "print(f\"Pedidos con monto superior al umbral (${UMBRAL:,}): {conteo_sobre_umbral}\")\n",
        "print(f\"Total de pedidos atrasados: {pedidos_atrasados}\")\n",
        "print(f\"Total de pedidos en sucursal Norte: {pedidos_norte}\")"
      ]
