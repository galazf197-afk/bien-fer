      "source": [
        "\n",
        "# Taller 2: Fundamentos de Python para Ciencia de Datos (Caso AndesLog)\n",
        "# ==============================================================================\n",
        "\n",
        "# Definir la variable UMBRAL (constante para parametrizar la regla de negocio)\n",
        "UMBRAL = 20_000\n",
        "\n",
        "#Crear la lista de diccionarios'pedidos'\n",
        "pedidos = [\n",
        "    {\"id\": 1, \"sucursal\": \"Norte\", \"monto\": 125000, \"atrasado\": False},\n",
        "    {\"id\": 2, \"sucursal\": \"Centro\", \"monto\": 18000, \"atrasado\": True},\n",
        "    {\"id\": 3, \"sucursal\": \"Sur\", \"monto\": 52000, \"atrasado\": False},\n",
        "    {\"id\": 4, \"sucursal\": \"Norte\", \"monto\": None, \"atrasado\": True},\n",
        "]\n",
        "\n",
        "# Crear acumuladores (inicializados antes del bucle)\n",
        "cantidad_validos = 0\n",
        "total_montos = 0\n",
        "conteo_sobre_umbral = 0\n",
        "\n",
        "# Recorrer los pedidos con bucle for\n",
        "for pedido in pedidos:\n",
        "    monto = pedido[\"monto\"]\n",
        "\n",
        "    #Condición para detectar monto ausente (None) y omitirlo\n",
        "    if monto is None:\n",
        "        continue  # Omite registros incompletos sin eliminarlos\n",
        "\n",
        "    # Aplicar operadores y condicionales para acumular datos válidos\n",
        "    cantidad_validos += 1\n",
        "    total_montos += monto\n",
        "\n",
        "    if monto > UMBRAL:\n",
        "        conteo_sobre_umbral += 1\n",
        "\n",
        "#  Calcular el promedio de los montos válidos\n",
        "if cantidad_validos > 0:\n",
        "    promedio = total_montos / cantidad_validos\n",
        "else:\n",
        "    promedio = 0.0\n",
        "\n",
        "# Mostrar resultados en consola\n",
        "print(\"----- RESULTADOS CASO ANDESLOG -----\")\n",
        "print(\"Cantidad válida:\", cantidad_validos)\n",
        "print(\"Total:\", total_montos)\n",
        "print(\"Promedio:\", promedio)\n",
        "print(\"Sobre el umbral 20000:\", conteo_sobre_umbral)"
      ],
