# Script base completo del Taller 2
UMBRAL = 40000

#Cada elemento representa un pedido con su ID, sucursal, monto y estado de entrega.
pedidos = [ 
    {"id": 1, "sucursal": "Norte", "monto": 12500, "atrasado": False}, 
    {"id": 2, "sucursal": "Centro", "monto": 18000, "atrasado": True}, 
    {"id": 3, "sucursal": "Sur", "monto": 52000, "atrasado": False}, 
    {"id": 4, "sucursal": "Norte", "monto": None, "atrasado": True},
    {"id": 5, "sucursal": "Londres", "monto":1000, "atrasado": False},
]
# Deben definirse con valor cero antes de iniciar el ciclo de lectura.
cantidad_validos = 0
total_montos = 0 #wena wena watong
conteo_sobre_umbral = 0
pedidos_atrasados = 0
cuenta_sucursales= 0

#Lista de pedidos
for pedido in pedidos:
    # Extracción de la variable 'monto' 
    monto = pedido["monto"]

    #validación de monto nulo
    if monto is None:
        continue
        
    cantidad_validos += 1
    total_montos += monto

    #comparación con el umbral
    if monto > UMBRAL:
        conteo_sobre_umbral += 1 


    if pedido["atrasado"] == False:
        pedidos_atrasados += 1 

    if pedido["sucursal"] == "Norte":
        cuenta_sucursales += 1

#calculo del promedio
promedio = total_montos / cantidad_validos

#resultados
print("Cantidad válida:", cantidad_validos)
print("Total:", total_montos)
print("Promedio:", promedio)
print("Sobre el umbral 40000:", conteo_sobre_umbral)
print("Atrasados:", pedidos_atrasados)
print("Sucursales en el Norte:", cuenta_sucursales)
